# 复制为 .env 后填入；.env 已被 .gitignore 忽略，不会提交
DEEPSEEK_API_KEY=
# 结构化抽取推荐 deepseek-chat（非思考模型）；deepseek-flash 会把额度花在推理上
LLM_MODEL=deepseek-chat
# 思考模型返回空内容时自动降级到该模型
LLM_FALLBACK_MODEL=deepseek-chat
# 预算：人民币，默认 20 元；达到 50%/80% 告警，100% 停止
LLM_BUDGET_CNY=20
# 单次回复上限：对象/关系 JSON 约 1.5k~2.5k tokens；太小会被截断成非法 JSON（默认 4000）
LLM_MAX_TOKENS=4000
LLM_MAX_CALLS=200
